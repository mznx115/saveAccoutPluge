{
  "manifest_version": 3,
  "name": "保存账号插件",
  "version": "0.1.0",
  "description": "按二级域名把 Cookie 与本地存储保存到本地文件，一键清空并切换账号。数据只存在你自己指定的文件夹里。",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "tabs",
    "downloads",
    "unlimitedStorage",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "保存账号插件",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
